{
    "name": "obsidian-fatsecret-diary",
    "version": "1.0.0",
    "description": "Import FatSecret diary into Obsidian notes",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint ."
    },
    "keywords": ["obsidian", "fatsecret", "nutrition", "diary"],
    "license": "MIT",
    "author": "Your Name",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-username/obsidian-fatsecret-diary.git"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/crypto-js": "^4.2.2",
        "@types/node": "^22.15.17",
        "crypto-js": "^4.2.0",
        "esbuild": "0.25.5",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.4.0",
        "globals": "^17.6.0",
        "jiti": "^2.6.1",
        "obsidian": "latest",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.59.1"
    }
}